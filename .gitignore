# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
build/
dist/

# Pipeline outputs and data (large; fetched or regenerated by script)
runs/
data/
*.ply
*.npz
benchmark/results/*/debug/
fixloop/worktrees/

# Model weights and caches live outside the repo (~/.cache/groundplan)
weights/
.cache/

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
# fix-loop regenerations: keep only each run's metrics and report
fixloop/runs/*/*
!fixloop/runs/*/metrics.json
!fixloop/runs/*/benchmark_report.md
